{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revaloop",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.revaloop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Revaloop · Compagnon local",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Le compagnon local de Revaloop.",
    "longDescription": "Sélectionne, lance et surveille explicitement un projet local avant son partage dans un espace de recette Revaloop.",
    "copyright": "Copyright 2026 Revaloop contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
