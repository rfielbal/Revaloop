{
  "name": "revaloop",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "La plateforme open source de recette client, du lien de test à la validation.",
  "workspaces": [
    "desktop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:pilot-preview",
    "test:pilot-preview": "npm --prefix examples/pilot-preview test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/out --ignore-pattern desktop/release",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run electron:dev --workspace @revaloop/desktop",
    "desktop:build": "npm run electron:build --workspace @revaloop/desktop",
    "desktop:pack": "npm run electron:pack --workspace @revaloop/desktop",
    "desktop:dist": "npm run electron:dist --workspace @revaloop/desktop",
    "desktop:check": "npm run electron:check --workspace @revaloop/desktop",
    "desktop:tauri:dev": "npm run tauri:dev --workspace @revaloop/desktop",
    "desktop:tauri:build": "npm run tauri:build --workspace @revaloop/desktop",
    "desktop:tauri:check": "npm run tauri:check --workspace @revaloop/desktop"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "type": "module"
}
